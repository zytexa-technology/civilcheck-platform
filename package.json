{
  "name": "civilcheck",
  "private": true,
  "engines": {
    "node": "20.x",
    "pnpm": ">=11.7.0 <12.0.0"
  },
  "packageManager": "pnpm@11.7.0",
    "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:api": "pnpm --filter @civilcheck/api dev",
    "dev:admin": "pnpm --filter @civilcheck/admin dev",
    "dev:seller": "pnpm --filter @civilcheck/seller dev",
    "dev:buyer": "pnpm --filter @civilcheck/buyer start",
    "dev:buyer-web": "pnpm --filter @civilcheck/buyer-web dev",
    "build:api": "pnpm --filter @civilcheck/api... build",
    "build:buyer-web": "pnpm --filter @civilcheck/buyer-web... build"
  }
}
