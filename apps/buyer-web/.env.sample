# Backend API base URL (no trailing slash, no /api suffix — src/api/client.ts adds that).
#   local  → VITE_API_URL=http://localhost:3000
#   deploy → set in the Vercel dashboard to your deployed API URL
VITE_API_URL=http://localhost:3000

# Optional: Razorpay publishable key id for real (non-mock) checkout. Leave
# unset in dev — the backend reports razorpayKeyId per-order, and the buyer-web
# checkout uses whatever the backend says. This var is only a fallback for
# environments where you want to force the Checkout.js script to load even
# before an order has been created (e.g. warm-loading the SDK). NEVER put a
# Razorpay *secret* here — only the publishable key id is safe in a VITE_ var.
VITE_RAZORPAY_KEY_ID=

# Firebase phone-OTP login (optional — additive to the existing email/password
# login, never required). Leave all four unset to keep the mock adapter: the
# phone/OTP toggle on the login page shows a "not configured" notice instead
# of a live reCAPTCHA/SMS flow. Copy these from the Firebase Console — Project
# settings > General > Your apps > CivilCheck Web > SDK setup and
# configuration > Config. Never put a Firebase *service account* key here —
# these four are the public web-app config, safe for a client bundle. (Types
# already declared in src/vite-env.d.ts.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
