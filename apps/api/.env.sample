DATABASE_URL="postgresql://postgres:root@localhost:5432/dbName?schema=public"
JWT_SECRET="a_secure_randomly_generated_string_for_local_testing"
# development | test | production. Leave unset/"development" for local work.
# In production this flips every mock/dev-fallback adapter (Razorpay orders,
# RazorpayX payouts, Firebase token verification) to hard-refuse instead of
# mocking if the corresponding real credentials below are missing — set this
# to "production" ONLY once every credential in this file is a real,
# production value. Never leave it unset in a real deployment.
NODE_ENV=development
FRONTEND_URLS=
# Access-token lifetime for buyer/seller/admin JWTs (lib/jwt.ts). Accepts a
# jsonwebtoken duration string ('7d', '12h', '30m') or a bare number of
# seconds. Falls back to 7d if unset or invalid — safe to leave as-is.
ACCESS_TOKEN_EXPIRY=7d
PORT=3000

# ─── Logging ──────────────────────────────────────────────────────────────
# Winston log level (lib/logger.ts). Defaults to "info" if unset. One of:
# error | warn | info | http | verbose | debug | silly.
LOG_LEVEL=info

# ─── Firebase Auth (optional in dev) ─────────────────────────────────────────
# Leave BOTH unset to run the mock adapter: ID tokens are decoded WITHOUT
# verification so local dev/demos work without a Firebase project.
# Mock mode is refused when NODE_ENV=production.
# Set ONE of the following to enable real verification:
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Admin session ───────────────────────────────────────────────────────────
# Idle timeout for admin panel sessions, in minutes (default 30, PDF 5.1).
ADMIN_SESSION_TIMEOUT_MINUTES=30

# ─── Admin 2FA (TOTP) ────────────────────────────────────────────────────────
# Issuer name shown in Google Authenticator. Changing it after admins have
# enrolled only relabels the entry in their app — codes keep working.
TOTP_ISSUER="CivilCheck Admin"

# 2FA enrollment grace period (Day 2 carry-over #4). Default OFF — leave unset
# so today's unenrolled demo/seed admins (and the Jest suite's admin fixture)
# keep working. Set to "true" only once real admins exist and 2FA rollout is
# a deliberate choice: an unenrolled admin gets locked out of every route
# except /2fa/* once ADMIN_2FA_GRACE_PERIOD_DAYS (default 7) has passed since
# their account was created.
ADMIN_2FA_ENFORCE_GRACE_PERIOD=
ADMIN_2FA_GRACE_PERIOD_DAYS=7

# ─── Notifications ───────────────────────────────────────────────────────────
# Read at send time, not at boot. Leave a key blank and that channel logs the
# exact payload instead of sending; fill it in and restart to go live — no
# code change either way.

# Email — Resend (https://resend.com)
RESEND_API_KEY=
# Must be a domain verified in the Resend dashboard, or sends are rejected.
# civilcheck.online is the verified sending domain — do not point this at an
# unverified domain (e.g. resend.dev) for anything but Resend's own sandbox testing.
RESEND_FROM_EMAIL="CivilCheck <no-reply@civilcheck.online>"
# Seller portal origin used to build links inside KYC emails (kyc.service.ts).
# Falls back to http://localhost:5173 in dev if unset.
SELLER_APP_URL=http://localhost:5173
# Admin portal origin used to build the login link inside the new-admin
# welcome email (admin.controller.ts's createAdmin). Falls back to
# http://localhost:5174 in dev if unset.
ADMIN_APP_URL=http://localhost:5174

# SMS — deactivated. MSG91 was removed platform-wide (auth cutover to
# email+password login). sendSms() in notification.service.ts is now a no-op
# stub; there is nothing to configure here.

# ─── AI Support (lib/aiSupport.ts) ───────────────────────────────────────────
# Google Gemini API key for the AI support assistant (provider switched from
# Anthropic 2026-09-02 — GEMINI_API_KEY is the only variable this path reads
# now). Read at call time, not at boot. Leave blank in dev: support falls
# back to a deterministic knowledge-base keyword matcher (SupportKnowledgeEntry
# rows) instead of a live model — not "AI disabled", just rule-based matching
# that escalates to a human whenever it isn't confident. No hard production
# error when this is unset (unlike Razorpay/Cloudinary/Firebase) — support
# simply keeps running in knowledge-base-only mode until this is configured.
GEMINI_API_KEY=

# ─── Payments — Razorpay (https://razorpay.com) ──────────────────────────────
# Read at call time, not at boot. Leave these blank in dev: order creation
# returns realistic mock orders (order_mock_…), and webhook/checkout signatures
# verify against a dev secret, so the whole flow runs without a Razorpay account.
# Fill them in and restart to go live — no code change either way.
#
# In production, missing keys is a HARD error: createOrder refuses rather than
# minting a mock order, so a misconfigured deploy cannot record purchases while
# no money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ─── Document Upload CDN — Cloudinary (https://cloudinary.com) ───────────────
# Read at call time, not at boot. Leave these blank in dev: the signature
# endpoint returns a mock signature (won't validate against a real Cloudinary
# account, but the seller-panel direct-upload flow can still be exercised
# end-to-end). Fill them in and restart to go live — no code change either way.
#
# In production, missing keys is a HARD error — a misconfigured deploy must not
# hand out signatures that silently fail on the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Maps (Property System — Phase 2) ─────────────────────────────────
# NOT required for "View on Map" to work today — lib/maps.ts builds a real
# Google Maps deep link (https://www.google.com/maps?q=lat,lng) with no key
# and no billing account, same as a Google Maps "Share" link. This key is
# reserved for a future embedded/interactive map (Maps JavaScript API /
# react-native-maps), which is a separate frontend build, not part of this
# pass. Leave blank until that work is scheduled.
GOOGLE_MAPS_API_KEY=

# ─── RazorpayX Payouts (weekly seller settlement, PDF 8.3) ───────────────────
# A DIFFERENT Razorpay product from Checkout/Orders above — needs a funded
# RazorpayX current account. Read at call time, not at boot. Leave these blank
# in dev: the weekly settlement run mints mock payouts (pout_mock_…) and marks
# purchases settled without moving real money — there is no RazorpayX sandbox
# equivalent to Razorpay's test-mode Checkout, so a real payout can only be
# exercised against an actual funded account.
#
# RAZORPAYX_KEY_ID / RAZORPAYX_KEY_SECRET fall back to RAZORPAY_KEY_ID/SECRET
# above if left blank (many setups share one Razorpay account) — set them
# separately only if RazorpayX uses a distinct key pair.
#
# In production, a missing RAZORPAYX_ACCOUNT_NUMBER (or no key pair at all) is
# a HARD error — a misconfigured deploy must not mark sellers paid when no
# money moved.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# ─── Payout account encryption (7-Day Verification Acceptance, Claim &
# Professional Settlement System) ─────────────────────────────────────────────
# AES-256-GCM key used to encrypt an Admin's professional payout bank/UPI
# details at rest (lib/encryption.ts) — Seller.bankAccount/ifsc predate this
# feature and are unaffected. A 64-char hex string (32 bytes) is used
# directly as the key; any other value is scrypt-derived to 32 bytes. Read
# lazily, only when an Admin payout account is actually saved/read — leaving
# this unset never blocks the app from starting, it only blocks that one
# narrow feature. Generate one with `openssl rand -hex 32`.
PAYOUT_ENCRYPTION_KEY=

# ─── Razorpay Route (marketplace Linked Accounts) — Phase 4B foundation ──────
# NOT usable yet — see lib/razorpayRoute.ts's header for exactly what Razorpay-
# side approval and account setup this needs before it does anything. Leaving
# this unset (or "false") keeps every verification-marketplace payout on the
# real, already-working RazorpayX Payouts path above. Do not set this to
# "true" without also implementing the adapter's HTTP calls — isRouteConfigured()
# gates that, not this file.
RAZORPAY_ROUTE_ENABLED=

# ─── Local dev seed data (prisma/seed.ts) — NEVER set these in a deployed
# environment ───────────────────────────────────────────────────────────────
# Optional overrides for the demo admin passwords `pnpm exec prisma db seed`
# creates. Leave unset to use the seed script's own dev-only defaults. The
# seed script refuses to run at all when NODE_ENV=production, regardless of
# these — they only matter for local development / demo environments.
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUB_ADMIN_PASSWORD=
SEED_VIEWER_ADMIN_PASSWORD=

# ─── scripts/create-super-admin.ts (one-time, manual run only) ──────────────
# Never commit real values here — set these in your local, untracked .env
# (or pass inline on the command line) only when you actually run the script.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PHONE=

# ── Partner signup identity verification (Owner / Reporter / Expert) ────────
# The manual Aadhaar signup flow (number + provider OTP + Aadhaar photo) has
# been REMOVED. Signup collects no Aadhaar data for any role, so the old
# KYC_PROVIDER / KYC_PROVIDER_API_KEY / KYC_AADHAAR_HASH_SECRET /
# KYC_SIGNUP_BYPASS_ENABLED variables are gone and are no longer read.
#
# Identity verification is DigiLocker (block below). Whether it may be
# SKIPPED is decided in ONE place — src/config/identityVerification.ts — and
# this variable is the override. It is enforced in the backend as well as the
# UI, so hiding the button is never the only thing stopping an unverified
# signup:
#   unset / true  → "Skip for now" is shown; signup may complete WITHOUT
#                   DigiLocker and the account is recorded NOT verified
#   false         → "Skip for now" disappears and sellerRegister refuses to
#                   create an account without a genuinely VERIFIED
#                   DigilockerSignupSession (go-live setting)
# Defaults to true only because DigiLocker credentials are not issued yet.
# DIGILOCKER_SIGNUP_SKIP_ENABLED=true

# ── DigiLocker / API Setu (Requestor API + SSO) — PENDING APPROVAL ──────────
# Leave empty until API Setu issues credentials. Empty => the integration
# reports NOT CONFIGURED and the "Verify with DigiLocker" button answers
# "temporarily unavailable" (the app still runs normally). See
# docs/digilocker-integration.md. Endpoints/scope/profile path are the OFFICIAL
# values from the API Setu documentation — none are hardcoded in the app.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_AUTH_URL=
DIGILOCKER_TOKEN_URL=
DIGILOCKER_API_BASE_URL=
DIGILOCKER_PROFILE_PATH=
# DIGILOCKER_SCOPE=
# DIGILOCKER_ISSUER_ID=   # issued with API Setu approval (TODO: confirm where the official flow uses it)
