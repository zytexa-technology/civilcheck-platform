# Copy to .env and edit if the API does not run on the same machine as Metro.
#
# When this is unset the app derives the API host from the Metro dev-server
# address (see src/config/env.ts), which is correct for the usual
# "API and Expo on the same laptop" setup and survives a network change.
#
# A production build has no Metro host to read, so a shipped app MUST set this.
#
# Two cases where you have to set it by hand in development:
#   Android emulator — "localhost" is the emulator itself, not your machine:
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   API on another machine — point at that machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000
