# Backend API base URL (no trailing slash, no /api suffix — axios.js adds that).
# Required — without it, API calls silently fail. See src/api/axios.js.
VITE_API_URL=http://localhost:3000

# Firebase phone-OTP login (optional — additive to the existing email/password
# login, never required). Leave all four unset to keep the mock adapter: the
# phone/OTP toggle on the login page shows a "not configured" notice instead
# of a live reCAPTCHA/SMS flow. Copy these from the Firebase Console — Project
# settings > General > Your apps > CivilCheck Web > SDK setup and
# configuration > Config. Never put a Firebase *service account* key here —
# these four are the public web-app config, safe for a client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
